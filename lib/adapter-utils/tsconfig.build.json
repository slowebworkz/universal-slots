{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // Build against core's emitted declarations, not its source.
    "paths": {},
    "noEmitOnError": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
