{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    // Typecheck against core's source so the workspace does not need a prior
    // build. This mapping is workspace-only; core's published export map points
    // strictly at `dist`.
    "paths": {
      "@universal-slots/conformance": ["../../lib/conformance/src/index.ts"],
      "@universal-slots/adapter-utils": [
        "../../lib/adapter-utils/src/index.ts"
      ],
      "@universal-slots/core": ["../../lib/core/src/index.ts"]
    }
  },
  "include": ["src"]
}
